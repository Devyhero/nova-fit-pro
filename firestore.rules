rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check function based on verified Google email
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in ['benznova01@gmail.com', 'parinya6969@gmail.com'];
    }

    // User profile and application state document:
    // User can read and write their own data, and verified Admin can read all users
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for direct notifications & messages from Admin
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admin message logs collection: only verified Admin can read & write
    match /admin_messages_log/{logId} {
      allow read, write: if isAdmin();
    }

    // System configuration (e.g. AI settings, shared quota, mascot remote config):
    // Public read for app configuration; only verified Admin can write
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Scan Logs Collection:
    // Authenticated users can record scan activity; verified Admin can read & delete
    match /ai_scan_logs/{logId} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }
    // Global AI Food Cache Collection:
    // Shared crowdsourced cache for analyzed meals to save Gemini tokens & provide instant responses
    // Public read for nutrition lookups; authenticated users or active sessions can contribute & update hits
    match /ai_food_cache/{cacheId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Guest & Unauthenticated Visitor Activity Tracking (Phase 1):
    // Allows unauthenticated visitors to heartbeat/record their own device stats; verified Admin or converted auth user can delete
    match /guest_sessions/{deviceId} {
      allow create, update: if request.resource.data.deviceId == deviceId;
      allow delete: if isAdmin() || request.auth != null;
      allow read: if isAdmin();
    }

    // Security Audit Logs Collection (Phase 3 Anti-Cheat & Bot Protection):
    // Allows logging suspicious tampering events; only verified Admin can read and manage
    match /security_audit_logs/{logId} {
      allow create: if request.resource.data.keys().hasAll(['type', 'timestamp', 'reason']);
      allow read, delete: if isAdmin();
    }

    // Push Notification Device Tokens (FCM):
    // Allows any device (Guest or Authenticated User) to register or update their own FCM token;
    // Verified Admin can read all tokens for broadcasting and audience analytics
    match /fcm_tokens/{tokenId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // Push Notification Schedule & Message Pool Config:
    // Anyone can read scheduled message pools; only verified Admin can update
    match /push_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Push Broadcast History & Queue:
    // Anyone can read broadcasts; verified Admin can create and manage
    match /push_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
