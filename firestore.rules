rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check function based on verified Google email
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in ['benznova01@gmail.com', 'parinya6969@gmail.com'];
    }

    // User profile and application state document:
    // User can read and write their own data, and verified Admin can read all users
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
