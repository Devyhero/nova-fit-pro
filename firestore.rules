rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check function based on verified Google email
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in ['benznova01@gmail.com', 'parinya6969@gmail.com'];
    }

    // User profile and application state document:
    // User can read and write their own data, and verified Admin can read all users
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for direct notifications & messages from Admin
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admin message logs collection: only verified Admin can read & write
    match /admin_messages_log/{logId} {
      allow read, write: if isAdmin();
    }

    // System configuration (e.g. AI settings, shared quota):
    // Authenticated users can read configuration, only verified Admin can write
    match /system_config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
